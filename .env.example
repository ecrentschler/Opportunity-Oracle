# Opportunity Oracle — environment config
# Copy to .env (optional; all have sane defaults for local dev)

# ── Server ─────────────────────────────────────────────
PORT=3000

# Where the JSON data store lives.
# LOCAL:   leave unset (defaults to ./oracle-data.json)
# RAILWAY: set to a mounted volume path so data survives redeploys:
# DB_PATH=/data/oracle-data.json

# Public base URL — used in deep links. Set on Railway to your assigned URL.
# PUBLIC_URL=https://oracle-production.up.railway.app

# ── Scheduling ─────────────────────────────────────────
# Hourly scans by default. Cron syntax.
# Faster: */30 * * * *  (every 30 min)
# Slower: 0 */4 * * *   (every 4 hours)
SCAN_CRON=0 * * * *

# ── Optional: email digest (disabled by default) ───────
# The user chose PWA-first — no passive emails. If you change your mind:
#   1. Uncomment the digest schedule in src/jobs/scheduler.js
#   2. Set DIGEST_TO + SMTP_* below
#   3. Restart
# DIGEST_TO=you@example.com
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxx_your_api_key_here
# SMTP_FROM="Oracle <oracle@yourdomain.com>"
